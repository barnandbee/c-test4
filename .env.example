# Copy to `.env` before running docker compose (compose reads it via env_file).
# Every value has a sensible default in app/config.py; override as needed.

# --- Database ---------------------------------------------------------------
# For docker compose this is set in the compose file; only override for local runs.
# DATABASE_URL=postgresql+psycopg2://jobs:jobs@localhost:5432/jobs

# --- Crawler identity (REQUIRED to be a real address before crawling live) --
# This email is sent in the User-Agent so site admins can contact you.
CRAWLER_CONTACT_EMAIL=you@example.org
CRAWLER_USER_AGENT_NAME=AusUniJobsBoard

# --- Crawl conduct (see CRAWLING.md) ----------------------------------------
REQUEST_DELAY_SECONDS=4.0        # minimum gap between requests to one domain
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=4
RESPECT_ROBOTS=true
MIN_YIELD_RATIO=0.5              # runs below this fraction of last count are 'suspect'
REFRESH_TIMES_PER_DAY=3          # full refreshes per day (kept low on purpose)
